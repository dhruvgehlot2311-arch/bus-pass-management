# ─────────────────────────────────────────────────────────────────────────────
# Bus Pass Management — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Replace <username>, <password>, and cluster URL with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/buspass

# Secret key used to sign JWTs — use a long, random string in production
JWT_SECRET=your_jwt_secret_here

# Port the Express server listens on
PORT=5000

# URL of the React frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# Application environment: development | production
NODE_ENV=development
