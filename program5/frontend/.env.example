# ─────────────────────────────────────────────────────────────────────────────
# Bus Pass Management — Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# All variables MUST start with VITE_ to be exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Express backend API
# In production, replace with your Render deployment URL
VITE_API_URL=http://localhost:5000
